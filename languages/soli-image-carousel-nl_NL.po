#. Plugin Name of the plugin
#: soli-image-carousel-plugin.php
msgid "Soli Image Carousel Plugin"
msgstr "Soli Image Carousel Plugin"

#. Description of the plugin
#: soli-image-carousel-plugin.php
msgid "Gutenberg block that turns a selection from the media library into an image carousel with progress indicators, thumbnails, fullscreen and download."
msgstr "Gutenberg-blok dat een selectie uit de mediabibliotheek omzet in een afbeeldingencarrousel met voortgangsindicatoren, miniaturen, volledig scherm en download."

#. Author of the plugin
#: soli-image-carousel-plugin.php
msgid "Joran Out"
msgstr "Joran Out"

#: build/image-carousel/render.php:48
msgid "Image carousel"
msgstr "Afbeeldingencarrousel"

#. translators: 1: slide number, 2: total slides
#: build/image-carousel/render.php:65
#, php-format
msgid "%1$d of %2$d"
msgstr "%1$d van %2$d"

#: build/image-carousel/render.php:91
msgid "Previous image"
msgstr "Vorige afbeelding"

#: build/image-carousel/render.php:94
msgid "Next image"
msgstr "Volgende afbeelding"

#: build/image-carousel/render.php:102
msgid "Download image"
msgstr "Afbeelding downloaden"

#: build/image-carousel/render.php:106
msgid "Fullscreen"
msgstr "Volledig scherm"

#: build/image-carousel/render.php:106
msgid "Exit fullscreen"
msgstr "Volledig scherm sluiten"

#: build/image-carousel/render.php:113
msgid "Choose image"
msgstr "Kies afbeelding"

#. translators: %d: slide number
#: build/image-carousel/render.php:115
#: build/image-carousel/render.php:124
#, php-format
msgid "Go to image %d"
msgstr "Ga naar afbeelding %d"

#: build/image-carousel/render.php:122
msgid "Thumbnails"
msgstr "Miniaturen"

#: inc/blocks.php:22
msgid "Soli Image Carousel: build/blocks-manifest.php is missing. Run \"npm run build\" in the plugin directory."
msgstr "Soli Image Carousel: build/blocks-manifest.php ontbreekt. Voer \"npm run build\" uit in de pluginmap."

